#set page(
  paper: "a4",
  margin: (x: 18mm, y: 16mm),
  numbering: "1 / 1",
)

#set text(
  font: ("Arial", "Hiragino Sans GB"),
  size: 9pt,
  fill: rgb("#263640"),
  lang: "zh",
)

#set par(
  justify: false,
  leading: 0.62em,
)

#let navy = rgb("#173e59")
#let blue = rgb("#267a9c")
#let pale = rgb("#edf5f8")
#let muted = rgb("#5c6b75")
#let border-color = rgb("#cad8df")

#let section(title) = {
  v(10pt)
  text(size: 14pt, weight: "bold", fill: navy)[#title]
  v(3pt)
  rect(width: 100%, height: 1.2pt, fill: blue, stroke: none)
  v(7pt)
}

#let info(label, value) = {
  grid(
    columns: (35mm, 1fr),
    column-gutter: 5mm,
    text(weight: "bold", fill: blue)[#label],
    value,
  )
  v(3pt)
}

#let job(
  title,
  role-names,
  description,
  missions,
) = {
  block(
    width: 100%,
    breakable: false,
    stroke: 0.8pt + border-color,
    radius: 5pt,
    inset: 10pt,
  )[
    #text(size: 11pt, weight: "bold", fill: navy)[#title]

    #v(5pt)
    #text(size: 8pt, weight: "bold", fill: blue)[
      可能的岗位名称
    ]
    #linebreak()
    #text(size: 8.3pt, fill: muted)[#role-names]

    #v(6pt)
    #description

    #v(6pt)
    #text(size: 8pt, weight: "bold", fill: blue)[
      典型工作内容
    ]
    #v(2pt)
    #for mission in missions [
      #grid(
        columns: (7pt, 1fr),
        column-gutter: 2pt,
        text(fill: blue)[-],
        text(size: 8.3pt)[#mission],
      )
    ]
  ]
  v(8pt)
}

#align(center)[
  #text(size: 23pt, weight: "bold", fill: navy)[
    毕业实习岗位与工作内容
  ]
  #v(4pt)
  #text(size: 11pt, weight: "bold", fill: blue)[
    计算机科学硕士二年级毕业实习
  ]
  #v(4pt)
  #text(size: 9pt, fill: muted)[
    张亚奇 - 蒙彼利埃大学 - IMAGINE 方向
  ]
]

#v(13pt)

#block(
  width: 100%,
  fill: pale,
  radius: 5pt,
  inset: 11pt,
)[
  #info("期望开始时间", [2027 年 2 月])
  #info("实习时长", [6 个月])
  #info("可接受地点", [法国、欧洲、中国或远程])
  #info(
    "机构类型",
    [
      科技公司、游戏工作室、研发团队、研究实验室或初创企业。
    ],
  )
]

#section("个人背景与实习目标")

我目前是蒙彼利埃大学计算机科学硕士二年级学生，就读于
IMAGINE 方向，同时在蒙彼利埃 IAE 管理学院修读技术与科学管理双学位。

我希望寻找一份技术型毕业实习，参与 3D 图形软件、渲染、物理仿真、
图像处理、计算机视觉、游戏程序开发、虚拟现实或交互式应用的
设计、开发、实验与优化工作。

我尤其希望参与既有算法基础、又有具体应用场景的项目，例如渲染器、
物理模拟器、图像与视觉系统、交互式原型、游戏系统、医学软件、
沉浸式应用或影视动画技术工具。

