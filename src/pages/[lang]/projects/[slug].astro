---
import Layout from '../../../layouts/Layout.astro';
import { defaultLang, isLang, languageList } from '../../../i18n/languages';
import { profile } from '../../../i18n/profile';
import { projects } from '../../../i18n/projects';
import { useTranslations } from '../../../i18n/ui';

export function getStaticPaths() {
  return languageList.flatMap((lang) =>
    projects.map((project) => ({
      params: { lang, slug: project.slug },
      props: { project },
    })),
  );
}

const lang = isLang(Astro.params.lang) ? Astro.params.lang : defaultLang;
const { project } = Astro.props;
const t = useTranslations(lang);
const projectDescription = project.detailSummary?.[lang] ?? project.summary[lang];
const resultImages = project.images ?? (project.image ? [project.image] : []);
const leadImage = !project.video ? (project.detailImage ?? project.coverImage) : undefined;
const keyHighlightItems = project.sections?.[0]?.items ?? project.highlights;
const contributionItems = project.sections?.[1]?.items;
const hasProjectLinks = Boolean(project.sourceNote || project.repositoryUrl || project.demoUrl);
---

<Layout lang={lang} title={`${project.title[lang]} | ${profile.name}`} description={projectDescription}>
  <article class="project-detail">
    <p class="eyebrow">{project.category[lang]}</p>
    <h1>{project.title[lang]}</h1>
    <p class="summary">{projectDescription}</p>

    {
      project.video && (
        <figure class="lead-media">
          <video autoplay muted loop playsinline controls preload="metadata" poster={project.video.poster}>
            {project.video.mp4 && <source src={project.video.mp4} type="video/mp4" />}
            {project.video.webm && <source src={project.video.webm} type="video/webm" />}
          </video>
          {project.video.caption && <figcaption>{project.video.caption[lang]}</figcaption>}
        </figure>
      )
    }

    {
      leadImage && (
        <figure class="lead-media">
          <img src={leadImage.src} alt={leadImage.alt[lang]} decoding="async" />
          {leadImage.caption && <figcaption>{leadImage.caption[lang]}</figcaption>}
        </figure>
      )
    }

    {resultImages.map((image) => (
        <figure>
          <img src={image.src} alt={image.alt[lang]} loading="lazy" decoding="async" />
          {image.caption && <figcaption>{image.caption[lang]}</figcaption>}
        </figure>
      ))}

    <ul class="tag-list project-tags">
      {project.tags.map((tag) => <li>{tag}</li>)}
    </ul>

    {
      hasProjectLinks && (
        <section class="project-links">
          {project.sourceNote && <p>{project.sourceNote[lang]}</p>}
          <div class="button-row">
            {
              project.repositoryUrl && (
                <a class="button primary" href={project.repositoryUrl}>
                  {t('sourceCode')}
                </a>
              )
            }
            {project.demoUrl && <a class="button" href={project.demoUrl}>{t('demo')}</a>}
          </div>
        </section>
      )
    }

    {
      project.demoVideos && (
        <section class="demos" id="demo">
          <h2>{t('demos')}</h2>
          <div class="demo-grid">
            {project.demoVideos.map((demoVideo) => {
              const clips =
                demoVideo.videos ??
                (demoVideo.mp4
                  ? [
                      {
                        mp4: demoVideo.mp4,
                        poster: demoVideo.poster,
                      },
                    ]
                  : []);

              return (
                <figure class="demo-card">
                  <h3>{demoVideo.title[lang]}</h3>
                  <div class="demo-video-list">
                    {clips.map((clip) => (
                      <div class="demo-video">
                        {clip.title && <h4>{clip.title[lang]}</h4>}
                        <video controls playsinline preload="metadata" poster={clip.poster}>
                          <source src={clip.mp4} type="video/mp4" />
                        </video>
                      </div>
                    ))}
                  </div>
                  {demoVideo.caption && <figcaption>{demoVideo.caption[lang]}</figcaption>}
                </figure>
              );
            })}
          </div>
        </section>
      )
    }

    {
      keyHighlightItems && (
        <section class="highlights">
          <h2>{t('keyHighlights')}</h2>
          <ul>
            {keyHighlightItems.map((highlight) => (
              <li>{highlight[lang]}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      contributionItems && (
        <section class="highlights">
          <h2>{t('myContributions')}</h2>
          <ul>
            {contributionItems.map((contribution) => (
              <li>{contribution[lang]}</li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Layout>

<style>
  .project-detail {
    max-width: 880px;
  }

  .summary {
    font-size: 1.16rem;
  }

  .project-tags {
    margin-top: 34px;
  }

  figure {
    margin: 34px 0 24px;
  }

  .lead-media {
    margin-top: 28px;
  }

  img {
    width: 100%;
    display: block;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel);
  }

  video {
    width: 100%;
    max-height: 75vh;
    display: block;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #000;
    object-fit: contain;
  }

  figcaption {
    margin-top: 10px;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .project-links {
    margin-top: 40px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .project-links p {
    margin-bottom: 18px;
  }

  .highlights {
    margin-top: 42px;
    padding-top: 34px;
    border-top: 1px solid var(--line);
  }

  .demos {
    margin-top: 42px;
    padding-top: 34px;
    border-top: 1px solid var(--line);
  }

  .demo-grid {
    display: grid;
    gap: 28px;
  }

  .demo-card {
    margin: 0;
  }

  .demo-card h3 {
    margin-bottom: 12px;
    font-size: 1rem;
  }

  .demo-video-list {
    display: grid;
    gap: 18px;
  }

  .demo-video h4 {
    margin-bottom: 10px;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 700;
  }

  .highlights ul {
    display: grid;
    gap: 14px;
    margin: 0;
    padding-left: 20px;
    color: var(--muted);
    line-height: 1.7;
  }
</style>
