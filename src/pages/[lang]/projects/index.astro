---
import Layout from '../../../layouts/Layout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { defaultLang, isLang, languageList } from '../../../i18n/languages';
import { projects } from '../../../i18n/projects';
import { profile } from '../../../i18n/profile';
import { useTranslations } from '../../../i18n/ui';

export function getStaticPaths() {
  return languageList.map((lang) => ({ params: { lang } }));
}

const lang = isLang(Astro.params.lang) ? Astro.params.lang : defaultLang;
const t = useTranslations(lang);
---

<Layout lang={lang} title={`${t('navProjects')} | ${profile.name[lang]}`}>
  <section>
    <p class="eyebrow">{t('navProjects')}</p>
    <h1>{t('selectedProjects')}</h1>
    <p class="intro">{t('projectsIntro')}</p>
  </section>

  <section class="section">
    <div class="grid">
      {projects.map((project) => <ProjectCard lang={lang} project={project} />)}
    </div>
  </section>
</Layout>

<style>
  .intro {
    max-width: 700px;
    font-size: 1.12rem;
  }
</style>
