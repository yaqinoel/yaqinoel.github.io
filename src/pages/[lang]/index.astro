---
import Layout from '../../layouts/Layout.astro';
import HomePage from '../../components/HomePage.astro';
import { defaultLang, isLang, languageList } from '../../i18n/languages';
import { useTranslations } from '../../i18n/ui';

export function getStaticPaths() {
  return languageList.map((lang) => ({ params: { lang } }));
}

const lang = isLang(Astro.params.lang) ? Astro.params.lang : defaultLang;
const t = useTranslations(lang);
---

<Layout lang={lang} title={t('siteTitle')} description={t('heroSummary')} particleBackground>
  <HomePage lang={lang} />
</Layout>
