---
import Layout from '../../layouts/Layout.astro';
import { defaultLang, isLang, languageList } from '../../i18n/languages';
import { profile } from '../../i18n/profile';
import { useTranslations } from '../../i18n/ui';

export function getStaticPaths() {
  return languageList.map((lang) => ({ params: { lang } }));
}

const lang = isLang(Astro.params.lang) ? Astro.params.lang : defaultLang;
const t = useTranslations(lang);
---

<Layout lang={lang} title={`${t('navAbout')} | ${profile.name}`}>
  <section>
    <p class="eyebrow">{t('navAbout')}</p>
    <h1>{profile.name}</h1>
    <p class="intro">{t('heroSummary')}</p>
  </section>

  <section class="section">
    <h2>{t('education')}</h2>
    <div class="timeline">
      {
        profile.education.map((item) => (
          <article>
            <p class="period">{item.period}</p>
            <h3>{item.school}</h3>
            <p class="program">{item.program[lang]}</p>
            <p>{item.details[lang]}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <h2>{t('technicalFocus')}</h2>
    <ul class="tag-list">
      {profile.skills.map((skill) => <li>{skill}</li>)}
    </ul>
  </section>
</Layout>

<style>
  .intro {
    max-width: 760px;
    font-size: 1.12rem;
  }

  .timeline {
    display: grid;
    gap: 18px;
  }

  article {
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel);
  }

  .period {
    margin-bottom: 8px;
    color: var(--accent-strong);
    font-weight: 700;
  }

  h3 {
    margin-bottom: 8px;
  }

  .program {
    color: var(--text);
    font-weight: 700;
  }
</style>
