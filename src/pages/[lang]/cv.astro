---
import Layout from '../../layouts/Layout.astro';
import { defaultLang, isLang, languageList } from '../../i18n/languages';
import { profile } from '../../i18n/profile';
import { useTranslations } from '../../i18n/ui';

export function getStaticPaths() {
  return languageList.map((lang) => ({ params: { lang } }));
}

const lang = isLang(Astro.params.lang) ? Astro.params.lang : defaultLang;
const t = useTranslations(lang);
const cvDocuments = [
  {
    lang: 'en',
    label: t('cvEnglish'),
    url: '/cv/yaqi-zhang-resume-en.pdf',
    filename: 'Yaqi-ZHANG-Resume-English.pdf',
  },
  {
    lang: 'fr',
    label: t('cvFrench'),
    url: '/cv/yaqi-zhang-cv-fr.pdf',
    filename: 'Yaqi-ZHANG-CV-Francais.pdf',
  },
  {
    lang: 'zh',
    label: t('cvChinese'),
    url: '/cv/yaqi-zhang-resume-zh.pdf',
    filename: 'Yaqi-ZHANG-Resume-Chinese.pdf',
  },
] as const;
const currentDocument =
  cvDocuments.find((document) => document.lang === lang) ?? cvDocuments[0];
---

<Layout lang={lang} title={`${t('navCV')} | ${profile.name[lang]}`}>
  <section class="cv-page">
    <h1>{t('navCV')}</h1>
    <p>{t('cvIntro')}</p>
    <div class="button-row">
      <a class="button primary" href={currentDocument.url} target="_blank" rel="noreferrer">
        {t('cvOpen')}
      </a>
      <a class="button" href={currentDocument.url} download={currentDocument.filename}>
        {t('cvDownload')}
      </a>
    </div>
    <iframe
      class="cv-preview"
      src={currentDocument.url}
      title={`${currentDocument.label} ${t('navCV')} - ${profile.name[lang]}`}
    ></iframe>
  </section>
</Layout>

<style>
  .cv-page {
    padding-bottom: 32px;
  }

  .cv-preview {
    width: 100%;
    height: auto;
    aspect-ratio: 210 / 297;
    margin-top: 32px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel);
  }

  @media (max-width: 680px) {
    .cv-preview {
      margin-top: 24px;
    }
  }
</style>
