---
import ProjectCard from './ProjectCard.astro';
import type { Lang } from '../i18n/languages';
import { profile } from '../i18n/profile';
import { getFeaturedProjects } from '../i18n/projects';
import { useTranslations } from '../i18n/ui';

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;
const t = useTranslations(lang);
const featuredProjects = getFeaturedProjects();
---

<section class="hero">
  <div class="hero-main">
    <div class="identity">
      <img
        class="portrait"
        src="/media/profile/yaqi-zhang.jpg"
        alt={t('profilePhotoAlt')}
        width="640"
        height="640"
        loading="eager"
        fetchpriority="high"
      />
      <div class="identity-copy">
        <p class="eyebrow">{t('heroRole')}</p>
        <h1>{profile.name}</h1>
        <p class="specialization">{t('heroTitle')}</p>
      </div>
    </div>
    <p class="hero-summary">{t('heroSummary')}</p>
    <div class="button-row">
      <a class="button primary" href={`/${lang}/projects/`}>{t('viewProjects')}</a>
      <a class="button" href={`mailto:${profile.email}`}>{t('contactMe')}</a>
    </div>
  </div>

  <aside class="hero-details">
    <div class="detail-group">
      <p class="detail-label">{t('focusLabel')}</p>
      <ul class="focus-list">
        {profile.focusAreas.map((area) => <li>{area}</li>)}
      </ul>
    </div>
    <dl class="availability">
      <div>
        <dt>{t('internshipLabel')}</dt>
        <dd>{t('internshipValue')}</dd>
      </div>
      <div>
        <dt>{t('mobilityLabel')}</dt>
        <dd>{t('mobilityValue')}</dd>
      </div>
    </dl>
  </aside>
</section>

<section class="section">
  <h2>{t('selectedProjects')}</h2>
  <div class="grid">
    {featuredProjects.map((project) => <ProjectCard lang={lang} project={project} />)}
  </div>
</section>

<section class="section split">
  <div>
    <h2>{t('technicalFocus')}</h2>
    <ul class="tag-list">
      {profile.skills.map((skill) => <li>{skill}</li>)}
    </ul>
  </div>
  <aside>
    <p>{profile.location}</p>
    <p>{profile.email}</p>
    <p><a href={profile.github}>GitHub: yaqinoel</a></p>
  </aside>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(280px, 0.72fr);
    align-items: center;
    gap: 64px;
    min-height: 400px;
    padding: 34px 0 50px;
  }

  .identity {
    display: grid;
    grid-template-columns: 148px minmax(0, 1fr);
    align-items: center;
    gap: 26px;
    margin-bottom: 24px;
  }

  .portrait {
    width: 148px;
    height: 148px;
    display: block;
    border: 1px solid var(--line);
    border-radius: 50%;
    object-fit: cover;
  }

  .identity .eyebrow {
    margin-bottom: 10px;
  }

  .hero h1 {
    margin-bottom: 10px;
    font-size: clamp(2.4rem, 4vw, 3.5rem);
    line-height: 1.02;
  }

  .specialization {
    max-width: 520px;
    margin-bottom: 0;
    color: var(--text);
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    font-weight: 650;
    line-height: 1.35;
  }

  .hero-summary {
    max-width: 680px;
    margin-bottom: 0;
    font-size: 1.04rem;
  }

  .hero-details {
    display: grid;
    gap: 28px;
    padding: 24px 0 4px 28px;
    border-left: 1px solid var(--line);
  }

  .detail-label,
  dt {
    margin-bottom: 10px;
    color: var(--accent-strong);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .focus-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .focus-list li {
    color: var(--text);
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .availability {
    display: grid;
    gap: 18px;
    margin: 0;
  }

  .availability dt {
    margin-bottom: 4px;
  }

  .availability dd {
    margin: 0;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.5;
  }

  .split {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 32px;
  }

  .split aside {
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel);
  }

  .split aside p:last-child {
    margin-bottom: 0;
  }

  .split aside a {
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 28px;
      min-height: 0;
      padding: 22px 0 38px;
    }

    .identity {
      grid-template-columns: 112px minmax(0, 1fr);
      gap: 20px;
      margin-bottom: 20px;
    }

    .portrait {
      width: 112px;
      height: 112px;
    }

    .hero h1 {
      margin-bottom: 8px;
      font-size: clamp(2.15rem, 10vw, 3rem);
    }

    .hero-summary {
      font-size: 1rem;
      line-height: 1.6;
    }

    .hero .button-row {
      margin-top: 22px;
    }

    .hero-details {
      gap: 22px;
      padding: 22px 0 0;
      border-top: 1px solid var(--line);
      border-left: 0;
    }

    .availability {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .split {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .identity {
      grid-template-columns: 96px minmax(0, 1fr);
      gap: 16px;
    }

    .portrait {
      width: 96px;
      height: 96px;
    }

    .identity .eyebrow {
      font-size: 0.72rem;
    }

    .hero h1 {
      font-size: 2rem;
    }

    .specialization {
      font-size: 0.98rem;
    }

    .focus-list li {
      font-size: 0.86rem;
    }
  }
</style>
