---
import type { Lang } from '../i18n/languages';
import type { Project } from '../i18n/projects';

type Props = {
  lang: Lang;
  project: Project;
};

const { lang, project } = Astro.props;
const thumbnail = project.coverImage ?? project.image;
const comparisonImages = project.coverComparison ?? [];
const hasComparison = comparisonImages.length > 0;
---

<article class="project-card">
  {
    (hasComparison || thumbnail) && (
      <a
        class="thumbnail"
        style={hasComparison ? '--thumbnail-columns: 2; --thumbnail-rows: 2;' : undefined}
        href={`/${lang}/projects/${project.slug}/`}
        aria-label={project.title[lang]}
      >
        {hasComparison ? comparisonImages.map((image) => (
          <span class="comparison-tile">
            <img src={image.src} alt={image.alt[lang]} loading="lazy" decoding="async" />
            {image.caption && <span>{image.caption[lang]}</span>}
          </span>
        )) : thumbnail && (
          <img
            src={thumbnail.src}
            alt={thumbnail.alt[lang]}
            loading="lazy"
            style={`object-fit: ${project.coverFit ?? 'cover'};`}
          />
        )}
      </a>
    )
  }
  <p class="category">{project.category[lang]}</p>
  <h3>
    <a href={`/${lang}/projects/${project.slug}/`}>{project.title[lang]}</a>
  </h3>
  <p>{project.summary[lang]}</p>
  <ul class="tag-list">
    {project.tags.map((tag) => <li>{typeof tag === 'string' ? tag : tag[lang]}</li>)}
  </ul>
</article>

<style>
  .project-card {
    min-height: 100%;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(23, 26, 31, 0.78);
  }

  .thumbnail {
    display: grid;
    grid-template-columns: repeat(var(--thumbnail-columns, 1), minmax(0, 1fr));
    grid-template-rows: repeat(var(--thumbnail-rows, 1), minmax(0, 1fr));
    gap: 2px;
    width: 100%;
    margin-bottom: 16px;
    overflow: hidden;
    border-radius: 6px;
    background: var(--panel-strong);
    aspect-ratio: 16 / 10;
  }

  img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .comparison-tile {
    display: block;
    position: relative;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }

  .comparison-tile span {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 3px 5px;
    background: rgba(0, 0, 0, 0.68);
    color: #fff;
    font-size: 0.65rem;
    line-height: 1.25;
  }

  .category {
    margin-bottom: 10px;
    color: var(--accent-strong);
    font-size: 0.82rem;
    font-weight: 700;
  }

  h3 {
    margin-bottom: 12px;
    font-size: 1.15rem;
    line-height: 1.35;
  }

  h3 a:hover {
    color: var(--accent);
  }
</style>
