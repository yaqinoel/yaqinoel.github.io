<div class="particle-background" data-particle-background aria-hidden="true">
  <canvas data-particle-canvas></canvas>
</div>

<script>
  import * as THREE from 'three';
  import { TeapotGeometry } from 'three/examples/jsm/geometries/TeapotGeometry.js';
  import { MeshSurfaceSampler } from 'three/examples/jsm/math/MeshSurfaceSampler.js';

  type ParticleModel = {
    name: string;
    points: Float32Array;
  };

  type CloudSpec = {
    x: number;
    y: number;
    scale: number;
    opacity: number;
    drift: number;
  };

  type ParticleCloud = {
    points: THREE.Points<THREE.BufferGeometry, THREE.ShaderMaterial>;
    geometry: THREE.BufferGeometry;
    material: THREE.ShaderMaterial;
    positionAttribute: THREE.BufferAttribute;
    targetAttribute: THREE.BufferAttribute;
    pointerLocal: THREE.Vector3;
    basePosition: THREE.Vector3;
    spec: CloudSpec;
    currentModelIndex: number;
    targetModelIndex: number;
    morphStartedAt: number;
    nextMorphAt: number;
    morphing: boolean;
    phase: number;
  };

  const container = document.querySelector<HTMLElement>('[data-particle-background]');
  const canvas = container?.querySelector<HTMLCanvasElement>('[data-particle-canvas]');

  if (container && canvas) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const compact = window.innerWidth < 760;
    const sourcePointCount = 12000;
    const pointsPerCloud = compact ? 1400 : 2100;
    const cloudSpecs: CloudSpec[] = compact
      ? [
          { x: 0.27, y: 0.34, scale: 0.56, opacity: 0.9, drift: 0.65 },
          { x: -0.3, y: 0.12, scale: 0.43, opacity: 0.7, drift: 0.42 },
          { x: 0.2, y: -0.08, scale: 0.6, opacity: 0.84, drift: 0.56 },
          { x: -0.28, y: -0.28, scale: 0.46, opacity: 0.68, drift: 0.36 },
          { x: 0.16, y: -0.43, scale: 0.38, opacity: 0.62, drift: 0.3 },
        ]
      : [
          { x: -0.43, y: 0.31, scale: 0.44, opacity: 0.54, drift: 0.32 },
          { x: 0.36, y: 0.24, scale: 0.78, opacity: 0.88, drift: 0.7 },
          { x: 0.04, y: 0.38, scale: 0.34, opacity: 0.52, drift: 0.28 },
          { x: -0.18, y: -0.2, scale: 0.61, opacity: 0.68, drift: 0.5 },
          { x: 0.43, y: -0.29, scale: 0.5, opacity: 0.64, drift: 0.42 },
          { x: -0.43, y: -0.39, scale: 0.34, opacity: 0.48, drift: 0.26 },
          { x: 0.08, y: -0.43, scale: 0.31, opacity: 0.46, drift: 0.22 },
        ];

    let frameId = 0;
    let disposed = false;

    const loadPointModel = async (name: string, url: string): Promise<ParticleModel> => {
      const response = await fetch(url);

      if (!response.ok) {
        throw new Error(`Unable to load ${name}: ${response.status}`);
      }

      return { name, points: new Float32Array(await response.arrayBuffer()) };
    };

    const sampleGeometry = (name: string, geometry: THREE.BufferGeometry): ParticleModel => {
      geometry.computeVertexNormals();
      const mesh = new THREE.Mesh(geometry, new THREE.MeshBasicMaterial());
      mesh.updateMatrixWorld(true);

      const sampler = new MeshSurfaceSampler(mesh).build();
      const point = new THREE.Vector3();
      const points = new Float32Array(sourcePointCount * 3);
      const bounds = new THREE.Box3();

      for (let index = 0; index < sourcePointCount; index += 1) {
        sampler.sample(point);
        const offset = index * 3;
        points[offset] = point.x;
        points[offset + 1] = point.y;
        points[offset + 2] = point.z;
        bounds.expandByPoint(point);
      }

      const center = bounds.getCenter(new THREE.Vector3());
      const size = bounds.getSize(new THREE.Vector3());
      const scale = 2.25 / Math.max(size.x, size.y, size.z);

      for (let index = 0; index < points.length; index += 3) {
        points[index] = (points[index] - center.x) * scale;
        points[index + 1] = (points[index + 1] - center.y) * scale;
        points[index + 2] = (points[index + 2] - center.z) * scale;
      }

      geometry.dispose();
      mesh.material.dispose();
      return { name, points };
    };

    const createProceduralModels = (): ParticleModel[] => [
      sampleGeometry(
        'Utah Teapot',
        new TeapotGeometry(1, compact ? 5 : 7, true, true, true, true, true),
      ),
      sampleGeometry(
        'Icosahedral Shell',
        new THREE.IcosahedronGeometry(1, compact ? 3 : 4),
      ),
    ];

    const selectPoints = (
      model: ParticleModel,
      cloudIndex: number,
      modelIndex: number,
    ): Float32Array => {
      const sourceCount = Math.floor(model.points.length / 3);
      const points = new Float32Array(pointsPerCloud * 3);
      const strides = [7, 11, 13, 17, 19, 23, 29];
      const stride = strides[cloudIndex % strides.length];
      const start = (cloudIndex * 839 + modelIndex * 389) % sourceCount;

      for (let index = 0; index < pointsPerCloud; index += 1) {
        const sourceIndex = (start + index * stride) % sourceCount;
        const sourceOffset = sourceIndex * 3;
        const targetOffset = index * 3;
        points[targetOffset] = model.points[sourceOffset];
        points[targetOffset + 1] = model.points[sourceOffset + 1];
        points[targetOffset + 2] = model.points[sourceOffset + 2];
      }

      return points;
    };

    const vertexShader = `
      uniform float uTime;
      uniform float uMorph;
      uniform vec2 uPointer;
      uniform float uPointerStrength;
      uniform float uPixelRatio;
      uniform float uPointSize;
      attribute vec3 aTarget;
      attribute float aSeed;
      varying float vSeed;
      varying float vDepth;

      void main() {
        float easedMorph = uMorph * uMorph * (3.0 - 2.0 * uMorph);
        vec3 transformed = mix(position, aTarget, easedMorph);
        transformed += normalize(transformed + vec3(0.0001))
          * sin(uTime * 0.62 + aSeed * 13.0) * 0.012;

        vec2 pointerDelta = transformed.xy - uPointer;
        float pointerDistance = length(pointerDelta);
        float pointerInfluence = exp(-pointerDistance * pointerDistance * 1.35)
          * uPointerStrength;
        vec2 radial = normalize(pointerDelta + vec2(0.0001));
        vec2 tangent = vec2(-radial.y, radial.x);
        float ripple = 0.78 + sin(uTime * 2.1 + aSeed * 15.0) * 0.22;

        transformed.xy += radial * pointerInfluence * (0.3 + aSeed * 0.16) * ripple;
        transformed.xy += tangent * pointerInfluence * 0.075 * sin(uTime + aSeed * 8.0);
        transformed.z += pointerInfluence * 0.16 * sin(aSeed * 17.0 + uTime * 1.4);

        vec4 modelViewPosition = modelViewMatrix * vec4(transformed, 1.0);
        gl_Position = projectionMatrix * modelViewPosition;
        gl_PointSize = uPointSize * uPixelRatio * (3.1 / -modelViewPosition.z)
          * (0.76 + aSeed * 0.5);

        vSeed = aSeed;
        vDepth = clamp(1.0 - (-modelViewPosition.z - 3.5) / 3.4, 0.38, 1.0);
      }
    `;

    const fragmentShader = `
      uniform float uOpacity;
      varying float vSeed;
      varying float vDepth;

      void main() {
        float distanceToCenter = length(gl_PointCoord - vec2(0.5));
        float alpha = smoothstep(0.5, 0.08, distanceToCenter)
          * (0.5 + vDepth * 0.5) * uOpacity;
        vec3 cyan = vec3(0.404, 0.831, 1.0);
        vec3 mint = vec3(0.655, 0.953, 0.816);
        vec3 color = mix(cyan, mint, smoothstep(0.16, 0.9, vSeed));
        gl_FragColor = vec4(color, alpha);
      }
    `;

    const start = async () => {
      let renderer: THREE.WebGLRenderer;

      try {
        renderer = new THREE.WebGLRenderer({
          canvas,
          alpha: true,
          antialias: false,
          powerPreference: 'high-performance',
        });
      } catch (error) {
        console.warn('WebGL particle background is unavailable.', error);
        container.dataset.state = 'unavailable';
        return;
      }

      renderer.setClearColor(0x000000, 0);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, compact ? 1.25 : 1.5));

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 20);
      camera.position.z = 5;
      const proceduralModels = createProceduralModels();
      let scannedModels: ParticleModel[] = [];

      try {
        scannedModels = await Promise.all([
          loadPointModel('Stanford Bunny', '/models/stanford-bunny.bin'),
          loadPointModel('Stanford Armadillo', '/models/stanford-armadillo.bin'),
        ]);
      } catch (error) {
        console.warn('Stanford particle models could not be loaded.', error);
      }

      if (disposed) {
        renderer.dispose();
        return;
      }

      const models = [...scannedModels, ...proceduralModels];

      if (models.length === 0) {
        renderer.dispose();
        return;
      }

      const clouds: ParticleCloud[] = cloudSpecs.map((spec, cloudIndex) => {
        const currentModelIndex = cloudIndex % models.length;
        const targetModelIndex = (currentModelIndex + 1 + (cloudIndex % 2)) % models.length;
        const currentPoints = selectPoints(models[currentModelIndex], cloudIndex, currentModelIndex);
        const targetPoints = selectPoints(models[targetModelIndex], cloudIndex, targetModelIndex);
        const seeds = new Float32Array(pointsPerCloud);

        for (let index = 0; index < pointsPerCloud; index += 1) {
          seeds[index] = (index * 0.61803398875 + cloudIndex * 0.173) % 1;
        }

        const geometry = new THREE.BufferGeometry();
        const positionAttribute = new THREE.BufferAttribute(currentPoints, 3);
        const targetAttribute = new THREE.BufferAttribute(targetPoints, 3);
        geometry.setAttribute('position', positionAttribute);
        geometry.setAttribute('aTarget', targetAttribute);
        geometry.setAttribute('aSeed', new THREE.BufferAttribute(seeds, 1));

        const material = new THREE.ShaderMaterial({
          uniforms: {
            uTime: { value: cloudIndex * 0.47 },
            uMorph: { value: 0 },
            uPointer: { value: new THREE.Vector2(100, 100) },
            uPointerStrength: { value: 0 },
            uPixelRatio: { value: renderer.getPixelRatio() },
            uPointSize: { value: compact ? 6.3 : 5.35 },
            uOpacity: { value: spec.opacity },
          },
          transparent: true,
          depthWrite: false,
          blending: THREE.NormalBlending,
          vertexShader,
          fragmentShader,
        });

        const points = new THREE.Points(geometry, material);
        points.scale.setScalar(spec.scale);
        points.rotation.y = cloudIndex * 0.53;
        points.rotation.x = -0.06 + (cloudIndex % 3) * 0.035;
        scene.add(points);

        return {
          points,
          geometry,
          material,
          positionAttribute,
          targetAttribute,
          pointerLocal: new THREE.Vector3(100, 100, 0),
          basePosition: new THREE.Vector3(),
          spec,
          currentModelIndex,
          targetModelIndex,
          morphStartedAt: 0,
          nextMorphAt: 2.2 + cloudIndex * 0.85,
          morphing: false,
          phase: cloudIndex * 1.37,
        };
      });

      const pointerNdcTarget = new THREE.Vector2();
      const pointerNdcSmooth = new THREE.Vector2();
      const pointerWorldTarget = new THREE.Vector3(100, 100, 0);
      const pointerWorldSmooth = new THREE.Vector3(100, 100, 0);
      const pointerRay = new THREE.Vector3();
      const localPointer = new THREE.Vector3();
      let pointerStrengthTarget = 0;
      let scrollTarget = window.scrollY;
      let scrollSmooth = window.scrollY;
      let visibleHeight = 1;
      let visible = !document.hidden;

      const updateLayout = () => {
        const width = window.innerWidth;
        const height = window.innerHeight;
        const isNarrow = width < 760;

        camera.aspect = width / height;
        camera.updateProjectionMatrix();
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, isNarrow ? 1.25 : 1.5));
        renderer.setSize(width, height, false);

        visibleHeight = 2 * Math.tan(THREE.MathUtils.degToRad(camera.fov / 2)) * camera.position.z;
        const visibleWidth = visibleHeight * camera.aspect;

        clouds.forEach((cloud) => {
          cloud.basePosition.set(
            cloud.spec.x * visibleWidth,
            cloud.spec.y * visibleHeight,
            -0.12 - cloud.spec.drift * 0.24,
          );
          cloud.points.position.copy(cloud.basePosition);
          cloud.material.uniforms.uPixelRatio.value = renderer.getPixelRatio();
        });
      };

      const projectPointer = (clientX: number, clientY: number) => {
        pointerNdcTarget.set(
          (clientX / window.innerWidth) * 2 - 1,
          -(clientY / window.innerHeight) * 2 + 1,
        );
        pointerRay.set(pointerNdcTarget.x, pointerNdcTarget.y, 0.5).unproject(camera);
        pointerRay.sub(camera.position).normalize();
        const distance = -camera.position.z / pointerRay.z;
        pointerWorldTarget.copy(pointerRay).multiplyScalar(distance).add(camera.position);
      };

      const updatePointer = (event: PointerEvent) => {
        projectPointer(event.clientX, event.clientY);
        pointerStrengthTarget = event.pointerType === 'touch' ? 0.78 : 1;
        canvas.dataset.interactive = 'true';
      };

      const clearPointer = () => {
        pointerStrengthTarget = 0;
      };

      const updateScroll = () => {
        scrollTarget = window.scrollY;
        canvas.dataset.scroll = String(Math.round(scrollTarget));
      };

      const updateVisibility = () => {
        visible = !document.hidden;

        if (visible && !reducedMotion && frameId === 0) {
          frameId = requestAnimationFrame(renderFrame);
        }
      };

      const startedAt = Date.now();

      const renderFrame = () => {
        frameId = 0;
        if (disposed || !visible) return;

        const elapsed = (Date.now() - startedAt) / 1000;
        pointerNdcSmooth.lerp(pointerNdcTarget, 0.085);
        pointerWorldSmooth.lerp(pointerWorldTarget, 0.085);
        scrollSmooth = THREE.MathUtils.lerp(scrollSmooth, scrollTarget, 0.075);

        camera.position.x = THREE.MathUtils.lerp(
          camera.position.x,
          pointerNdcSmooth.x * (compact ? 0.26 : 0.58),
          0.065,
        );
        camera.position.y = THREE.MathUtils.lerp(
          camera.position.y,
          pointerNdcSmooth.y * (compact ? 0.18 : 0.36),
          0.065,
        );
        camera.lookAt(
          -pointerNdcSmooth.x * (compact ? 0.05 : 0.13),
          -pointerNdcSmooth.y * (compact ? 0.035 : 0.085),
          0,
        );

        clouds.forEach((cloud, cloudIndex) => {
          const uniforms = cloud.material.uniforms;
          uniforms.uTime.value = elapsed + cloud.phase;
          uniforms.uPointerStrength.value = THREE.MathUtils.lerp(
            uniforms.uPointerStrength.value,
            pointerStrengthTarget,
            pointerStrengthTarget > 0 ? 0.055 : 0.035,
          );

          if (!cloud.morphing && elapsed >= cloud.nextMorphAt && models.length > 1) {
            cloud.morphing = true;
            cloud.morphStartedAt = elapsed;
            const targetPoints = selectPoints(
              models[cloud.targetModelIndex],
              cloudIndex,
              cloud.targetModelIndex,
            );
            cloud.targetAttribute.array.set(targetPoints);
            cloud.targetAttribute.needsUpdate = true;
          }

          if (cloud.morphing) {
            const progress = Math.min((elapsed - cloud.morphStartedAt) / 3.4, 1);
            uniforms.uMorph.value = progress;

            if (progress >= 1) {
              cloud.positionAttribute.array.set(cloud.targetAttribute.array);
              cloud.positionAttribute.needsUpdate = true;
              uniforms.uMorph.value = 0;
              cloud.currentModelIndex = cloud.targetModelIndex;
              cloud.targetModelIndex = (cloud.targetModelIndex + 1 + (cloudIndex % 2)) % models.length;
              cloud.morphing = false;
              cloud.nextMorphAt = elapsed + 5.2 + (cloudIndex % 3) * 0.75;
            }
          }

          cloud.points.position.x =
            cloud.basePosition.x + pointerNdcSmooth.x * cloud.spec.drift * 0.28;
          const scrollDistance = scrollSmooth * (0.00105 + cloud.spec.drift * 0.00055);
          const verticalSpan = visibleHeight * 1.65;
          const scrolledY =
            cloud.basePosition.y + pointerNdcSmooth.y * cloud.spec.drift * 0.2 - scrollDistance;
          cloud.points.position.y =
            THREE.MathUtils.euclideanModulo(scrolledY + verticalSpan * 0.5, verticalSpan)
            - verticalSpan * 0.5;
          cloud.points.rotation.y =
            cloudIndex * 0.53 + Math.sin(elapsed * 0.15 + cloud.phase) * 0.16
            + pointerNdcSmooth.x * cloud.spec.drift * 0.22
            + scrollSmooth * 0.00012 * (cloudIndex % 2 === 0 ? 1 : -1);
          cloud.points.rotation.x =
            -0.06 + Math.cos(elapsed * 0.12 + cloud.phase) * 0.035
            + pointerNdcSmooth.y * cloud.spec.drift * 0.12;

          cloud.points.updateMatrixWorld();
          localPointer.copy(pointerWorldSmooth);
          cloud.points.worldToLocal(localPointer);
          cloud.pointerLocal.lerp(localPointer, 0.12);
          uniforms.uPointer.value.set(cloud.pointerLocal.x, cloud.pointerLocal.y);
        });

        renderer.render(scene, camera);
        frameId = requestAnimationFrame(renderFrame);
      };

      const cleanup = () => {
        if (disposed) return;
        disposed = true;
        cancelAnimationFrame(frameId);
        window.removeEventListener('resize', updateLayout);
        window.removeEventListener('pointermove', updatePointer);
        window.removeEventListener('pointerdown', updatePointer);
        window.removeEventListener('pointerup', clearPointer);
        window.removeEventListener('pointercancel', clearPointer);
        window.removeEventListener('scroll', updateScroll);
        document.documentElement.removeEventListener('mouseleave', clearPointer);
        document.removeEventListener('visibilitychange', updateVisibility);
        clouds.forEach((cloud) => {
          cloud.geometry.dispose();
          cloud.material.dispose();
        });
        renderer.dispose();
      };

      updateLayout();
      container.dataset.state = 'ready';
      canvas.dataset.clouds = String(clouds.length);
      canvas.dataset.particles = String(clouds.length * pointsPerCloud);
      canvas.dataset.models = models.map((model) => model.name).join(', ');
      canvas.dataset.scroll = String(Math.round(scrollTarget));

      window.addEventListener('resize', updateLayout, { passive: true });
      window.addEventListener('pointermove', updatePointer, { passive: true });
      window.addEventListener('pointerdown', updatePointer, { passive: true });
      window.addEventListener('pointerup', clearPointer, { passive: true });
      window.addEventListener('pointercancel', clearPointer, { passive: true });
      window.addEventListener('scroll', updateScroll, { passive: true });
      document.documentElement.addEventListener('mouseleave', clearPointer);
      document.addEventListener('visibilitychange', updateVisibility);
      document.addEventListener('astro:before-swap', cleanup, { once: true });

      if (reducedMotion) {
        renderer.render(scene, camera);
      } else {
        frameId = requestAnimationFrame(renderFrame);
      }
    };

    start();
  }
</script>

<style>
  .particle-background {
    position: fixed;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .particle-background::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(16, 18, 20, 0.8) 0%,
      rgba(16, 18, 20, 0.5) 44%,
      rgba(16, 18, 20, 0.18) 76%,
      rgba(16, 18, 20, 0.3) 100%
    );
    content: '';
  }

  canvas {
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 700ms ease;
  }

  [data-state='ready'] canvas {
    opacity: 0.9;
  }

  @media (max-width: 760px) {
    .particle-background::after {
      background: linear-gradient(
        180deg,
        rgba(16, 18, 20, 0.38) 0%,
        rgba(16, 18, 20, 0.58) 48%,
        rgba(16, 18, 20, 0.78) 100%
      );
    }

    [data-state='ready'] canvas {
      opacity: 0.84;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    canvas {
      transition: none;
    }
  }
</style>
