{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CV: 导出当前简历",
      "type": "process",
      "command": "typst",
      "args": [
        "compile",
        "cv/cv.typ",
        "cv/cv.pdf"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CV: 持续预览当前简历",
      "type": "process",
      "command": "typst",
      "args": [
        "watch",
        "cv/cv.typ",
        "cv/cv.pdf"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
